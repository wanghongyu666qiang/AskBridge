<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop rescap">
  <Identity
    Name="55AD4ABA.AskBridge"
    Publisher="CN=085D3D42-B8F4-43F7-BB9E-C0889168662A"
    Version="{{MSIX_VERSION}}"
    ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>AskBridge</DisplayName>
    <PublisherDisplayName>王宏宇</PublisherDisplayName>
    <Description>将 Windows 截图和文字安全投递到用户选择的 AI 网页。</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="zh-CN" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application
      Id="AskBridge"
      Executable="askbridge.exe"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="AskBridge"
        Description="截图与 AI 网页之间的安全桥梁"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension
          Category="windows.startupTask"
          Executable="askbridge.exe"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="AskBridgeStartupTask"
            Enabled="false"
            DisplayName="AskBridge" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
